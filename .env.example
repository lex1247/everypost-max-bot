TG_BOT_TOKEN=
EXPECTED_TG_BOT_USERNAME=EveryPost_bot
FREE_TEST_MODE=1
# local enables free automatic rewriting/publication even in FREE_TEST_MODE.
# openai keeps paid calls/publication blocked until FREE_TEST_MODE=0.
LLM_PROVIDER=openai
# Optional anonymous cloud test: set only after the owner agrees to share post texts with LLM7.
# LLM_PROVIDER=llm7
LLM7_APPROVED=0
LLM7_MODEL=minimax-m2.7
LOCAL_LLM_URL=http://127.0.0.1:18081
LOCAL_MODEL_NAME=everypost-local
# Optional: let the bot start and stop llama-server itself.
LLAMA_SERVER_PATH=
LOCAL_MODEL_PATH=
# Telegram ID of the owner. Channel editors are granted access through the posting menu.
OWNER_ID=
# Reader account credentials from https://my.telegram.org
# Optional: public Telegram previews work without these account credentials.
TG_API_ID=
TG_API_HASH=
# Render only: export locally with python login.py --export-render.
TG_SESSION_STRING=
VK_TOKEN=
VK_API_VERSION=5.199
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
OPENAI_API_KEY=
# Set an available text model in your API account.
OPENAI_MODEL=
POLL_SECONDS=30
DATA_DIR=data
REQUIRE_PERSISTENT_DISK=0
# MAX uses its bundled CA in a separate HTTP client; system trust is unchanged.

# Cloud web mode requires PostgreSQL. Leave disabled for local polling.
WEB_MODE=0
DATABASE_URL=
PUBLIC_URL=
REQUIRE_MIGRATION=0
MIGRATION_TOKEN=
